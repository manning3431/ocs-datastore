# Postgres
POSTGRES_USER=pmo_admin
POSTGRES_PASSWORD=change_me_before_first_run
POSTGRES_DB=pmo_dashboard
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_EMAIL=admin@example.com
